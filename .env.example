# Copy to .env and edit. UNIFI_HOST, UNIFI_API_KEY and TRMNL_WEBHOOK_URL are required.

# Webhook URL from your TRMNL private plugin (Strategy: Webhook).
TRMNL_WEBHOOK_URL=https://trmnl.com/api/custom_plugins/your-plugin-uuid

# Your console (UDM Pro SE, UDM Pro, Cloud Gateway, ...) on the LAN.
UNIFI_HOST=https://192.168.1.1
# Network API key: UniFi Network > Settings > Control Plane > Integrations > Create API Key.
UNIFI_API_KEY=
# Site to show: its name, internal name ("default") or id. Defaults to the first site.
# UNIFI_SITE=Default

# UniFi consoles use a self-signed certificate, so it isn't verified by default.
# Point UNIFI_CA_BUNDLE at a CA file, or set UNIFI_VERIFY_SSL=1 if the console has a trusted certificate.
# UNIFI_VERIFY_SSL=0
# UNIFI_CA_BUNDLE=/etc/ssl/certs/unifi.pem

# Optional but recommended: Site Manager API key from https://unifi.ui.com/settings/api-keys
# Adds the ISP name, WAN uptime, internet issues and the 24h latency / packet loss chart.
UNIFI_CLOUD_API_KEY=
# Only needed if you have several consoles and the site can't be matched automatically.
# Run "unifi_dashboard.py check" to list the ids.
# UNIFI_CLOUD_SITE_ID=

# PoE watts / budget and the last speed test come from UniFi's older, undocumented API using
# the same key. Set these to 0 if your console rejects it (the "check" mode tells you).
# SHOW_POE=1
# SHOW_SPEEDTEST=1

# Seconds between webhook pushes. TRMNL allows 12/hour (30/hour on TRMNL+),
# so keep this at 300 or higher (120 with TRMNL+).
PUSH_INTERVAL=300

# Webhook body limit in bytes: 2048, or 5120 with TRMNL+. The chart and lists are trimmed to fit.
PAYLOAD_LIMIT=2048

# strftime format for the "updated" time in the title bar (uses this machine's time zone).
# TIME_FORMAT=%I:%M %p

# serve mode only
# HOST=0.0.0.0
# PORT=5000
